+  static String tr(String english) => isRo ? (_ro[english] ?? english) : english;
+
+  static String status(String value) {
+    final normalized = value.trim().toLowerCase();
+    final english = switch (normalized) {
+      'pending' => 'Pending',
+      'offered' => 'Offered',
+      'assigned' => 'Assigned',
+      'enroute' => 'Enroute',
+      'arrived' => 'Arrived',
+      'pob' => 'Passenger on board',
+      'completed' => 'Completed',
+      'failed' => 'Failed',
+      'postponed' => 'Postponed',
+      'cancelled' => 'Cancelled',
+      'rejected' => 'Rejected',
+      'online' => 'Online',
+      'offline' => 'Offline',
+      _ => value,
+    };
+    return tr(english);
+  }
+
+  static String jobType(String value) {
+    final normalized = value.trim().toLowerCase();
+    return tr(switch (normalized) {
+      'delivery' => 'Delivery',
+      'collection' => 'Collection',
+      'service' => 'Service',
+      'multi_stop' => 'Multi-stop',
+      _ => 'Ride',
+    });
+  }
+
+  static String operation(String value) {
+    final normalized = value.trim().toLowerCase();
+    return tr(switch (normalized) {
+      'pickup' => 'Collection',
+      'delivery' => 'Delivery',
+      'pickup_delivery' => 'Pickup / delivery',
+      'passenger' => 'Passenger',
+      _ => 'Service',
+    });
+  }
+
+  static String countLabel(int value, String oneEn, String manyEn, String oneRo, String manyRo) {
+    if (isRo) return '$value ${value == 1 ? oneRo : manyRo}';
+    return '$value ${value == 1 ? oneEn : manyEn}';
+  }
+
+  static Locale get locale => isRo ? const Locale('ro', 'RO') : const Locale('en', 'GB');
+}
