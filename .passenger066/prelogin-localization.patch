+  Future<Map<String,dynamic>?> readCountry() async {
+    final raw = await _storage.read(key: _country);
+    if (raw == null || raw.trim().isEmpty) return null;
+    try {
+      final decoded = jsonDecode(raw);
+      if (decoded is Map) return Map<String,dynamic>.from(decoded);
+    } catch (_) {}
+    return null;
+  }
+
+  Future<void> writeCountry(Map<String,dynamic> value) async {
+    if (value.isEmpty) return;
+    await _storage.write(key: _country, value: jsonEncode(value));
+  }
   Future<void> writeRealtime(String? value) => value == null || value.isEmpty ? _storage.delete(key: _realtime) : _storage.write(key: _realtime, value: value);
 
