+  Future<void> refreshPublicCountry(String site,{bool notify=true}) async {
+    final normalized=AppConfig.normalizeSiteUrl(site);
+    if(normalized.isEmpty)return;
+    final publicApi=ApiClient(siteUrl:normalized);
+    try{
+      final health=await publicApi.health();
