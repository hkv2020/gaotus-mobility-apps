{
  "factoryVersion": "0.7.1",
  "appId": "ai.gaotus.gaotus4509.app",
  "appName": "Gaotus",
  "mode": "remote",
  "url": "https://gaotus.ai/",
  "themeColor": "#111827",
  "accentColor": "#22d3ee",
  "versionName": "0.1.0",
  "versionCode": 1,
  "features": {
    "share": true,
    "haptics": true,
    "openExternal": true,
    "deviceInfo": true,
    "camera": true,
    "location": true
  },
  "permissions": {
    "camera": true,
    "location": true,
    "microphone": false,
    "storage": false,
    "vibration": true,
    "play_services": true
  },
  "appSettings": {
    "status_bar_color": "#111827",
    "navigation_bar_color": "#111827",
    "orientation": "portrait",
    "fullscreen": false,
    "pinch_zoom": true,
    "disable_cache": false,
    "kiosk_mode": false,
    "scroll_bounce": true,
    "pull_to_refresh": true,
    "page_loader": true,
    "confirm_exit": true
  },
  "linkHandling": {
    "external_mode": "external",
    "allow_subdomains": true,
    "allow_http": false,
    "deep_linking": true,
    "custom_scheme": "gaotus"
  },
  "overrides": {
    "custom_css": "",
    "custom_js": "",
    "user_agent": "GaotusAppForge/0.7.1",
    "custom_headers": "",
    "cookie_persistence": true
  },
  "uiNavigation": {
    "header_enabled": false,
    "bottom_nav_enabled": false,
    "floating_button_enabled": false,
    "sidebar_enabled": false,
    "offline_enabled": true,
    "offline_title": "Offline",
    "offline_message": "Please check your internet connection.",
    "offline_background": "#111827",
    "offline_title_color": "#ffffff",
    "offline_message_color": "#d1d5db",
    "offline_title_size": 30,
    "offline_message_size": 14,
    "offline_title_weight": 700,
    "offline_message_weight": 400,
    "offline_button_text": "Try Again",
    "offline_button_background": "#22d3ee",
    "offline_button_text_color": "#111827",
    "offline_button_margin": 14,
    "error_enabled": true,
    "error_title": "Something went wrong",
    "error_message": "This page could not be loaded.",
    "error_background": "#111827",
    "error_title_color": "#ffffff",
    "error_message_color": "#d1d5db",
    "error_title_size": 30,
    "error_message_size": 14,
    "error_title_weight": 700,
    "error_message_weight": 400,
    "error_button_text": "Try Again",
    "error_button_background": "#22d3ee",
    "error_button_text_color": "#111827",
    "error_button_margin": 14,
    "page_loader_type": "circular",
    "page_loader_color": "#22d3ee",
    "page_loader_background": "#111827",
    "pull_refresh_color": "#22d3ee"
  },
  "backExit": {
    "disable_back_button": false,
    "disable_back_pages": [],
    "mode": "confirm",
    "message": "Press back again to exit",
    "exit_pages": ["/"]
  },
  "pdfViewer": {
    "enabled": true,
    "mode": "in_app"
  },
  "fileHandling": {
    "downloads_enabled": true,
    "wifi_only": false,
    "download_to_public": true
  },
  "environment": [],
  "notifications": {
    "provider": "none",
    "ask_permission_on_launch": false,
    "disable_foreground": false,
    "notification_icon_url": "",
    "firebase_project_id": "",
    "onesignal_app_id": ""
  },
  "security": {
    "prevent_screenshots": false,
    "biometric_lock": false
  },
  "communication": {
    "native_share": true,
    "external_phone_email": true
  },
  "deviceHardware": {
    "keep_screen_on": false,
    "clipboard_enabled": true,
    "open_app_settings": true
  },
  "localisation": {
    "language": "en",
    "rtl": false
  }
}
