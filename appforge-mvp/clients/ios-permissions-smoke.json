{
  "factoryVersion": "0.7.1",
  "appId": "ai.gaotus.appforge.iospermissions",
  "appName": "AppForge iOS Permissions Smoke",
  "mode": "remote",
  "url": "https://example.com/",
  "themeColor": "#111827",
  "accentColor": "#f97316",
  "versionName": "0.7.1",
  "versionCode": 7,
  "features": {
    "share": true,
    "haptics": true,
    "openExternal": true,
    "deviceInfo": true,
    "camera": true,
    "location": true
  },
  "permissions": {
    "camera": true,
    "location": true,
    "microphone": true,
    "storage": false,
    "vibration": true,
    "play_services": false
  },
  "appSettings": {
    "orientation": "portrait",
    "fullscreen": false,
    "pinch_zoom": true,
    "disable_cache": false,
    "kiosk_mode": false,
    "scroll_bounce": true,
    "pull_to_refresh": false,
    "page_loader": false,
    "confirm_exit": true
  },
  "linkHandling": {
    "external_mode": "external",
    "allow_subdomains": true,
    "allow_http": false,
    "deep_linking": false
  },
  "notifications": {
    "provider": "none"
  },
  "security": {
    "prevent_screenshots": false,
    "biometric_lock": false
  },
  "communication": {
    "native_share": true,
    "external_phone_email": true
  },
  "deviceHardware": {
    "keep_screen_on": false
  },
  "localisation": {
    "language": "en",
    "rtl": false
  },
  "environment": []
}
