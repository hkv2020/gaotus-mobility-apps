+import '../core/country_config.dart';
+
+final class DeliveryQuote {
+  const DeliveryQuote({
+    required this.price,
+    required this.distance,
+    required this.distanceUnit,
+    required this.durationMinutes,
+    this.priceFormatted = '',
+    this.breakdown = const <String, dynamic>{},
+  });
+
+  final double price;
+  final String priceFormatted;
+  final double distance;
+  final String distanceUnit;
+  final double durationMinutes;
+  final Map<String, dynamic> breakdown;
+
+  String get priceLabel => priceFormatted.isNotEmpty ? priceFormatted : CountryConfig.money(price);
+
+  factory DeliveryQuote.fromJson(Map<String, dynamic> j) => DeliveryQuote(
+        price: (j['price'] as num?)?.toDouble() ?? double.tryParse('${j['price']}') ?? 0,
+        priceFormatted: (j['price_formatted'] ?? '').toString(),
+        distance: (j['distance'] as num?)?.toDouble() ?? double.tryParse('${j['distance']}') ?? 0,
+        distanceUnit: (j['distance_unit'] ?? (CountryConfig.units == 'imperial' ? 'mi' : 'km')).toString(),
+        durationMinutes: (j['duration_minutes'] as num?)?.toDouble() ?? double.tryParse('${j['duration_minutes']}') ?? 0,
+        breakdown: j['breakdown'] is Map ? Map<String, dynamic>.from(j['breakdown'] as Map) : <String, dynamic>{},
+      );
+}
