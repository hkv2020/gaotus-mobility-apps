+  Future<void> refreshPublicCountry(String siteUrl,{bool notify=true}) async {
+    final normalized=AppConfig.normalizeSiteUrl(siteUrl);
+    if(normalized.isEmpty)return;
+    final publicApi=ApiClient(siteUrl: normalized);
+    try{
+      final health=await publicApi.health();
+      final raw=health['country'];
+      if(raw is Map){
+        final cfg=Map<String,dynamic>.from(raw);
+        if(cfg.isNotEmpty){
+          CountryConfig.configure(cfg);
+          await _store.writeCountry(cfg);
+          if(notify)notifyListeners();
+        }
+      }
+    }finally{publicApi.close();}
+  }
