@@ -0,0 +1,78 @@
+final class PassengerOperationStop {
+  const PassengerOperationStop({
+    required this.id,
+    required this.sequence,
+    required this.operationType,
+    required this.status,
+    required this.address,
+    this.name = '',
+    this.contactName = '',
+    this.contactPhone = '',
+    this.lat,
+    this.lng,
+    this.packageRef = '',
+    this.packageCount = 0,
+    this.packageWeightKg = 0,
+    this.packageSize = '',
+    this.recipientName = '',
+    this.recipientPhone = '',
+    this.notes = '',
+    this.proofs = const <Map<String, dynamic>>[],
+  });
+
+  final int id;
+  final int sequence;
+  final String operationType;
+  final String status;
+  final String address;
+  final String name;
+  final String contactName;
+  final String contactPhone;
+  final double? lat;
+  final double? lng;
+  final String packageRef;
+  final int packageCount;
+  final double packageWeightKg;
+  final String packageSize;
+  final String recipientName;
+  final String recipientPhone;
+  final String notes;
+  final List<Map<String, dynamic>> proofs;
+
+  bool get terminal => const <String>{'completed', 'failed'}.contains(status);
+  String get operationLabel => switch (operationType) {
+        'pickup' => 'Collection',
+        'delivery' => 'Delivery',
+        'pickup_delivery' => 'Stop',
+        'passenger' => 'Passenger stop',
+        _ => 'Service stop',
+      };
+
+  factory PassengerOperationStop.fromJson(Map<String, dynamic> j) {
+    double? d(Object? value) => value == null ? null : (value is num ? value.toDouble() : double.tryParse('$value'));
+    final rawProofs = j['proofs'];
+    final proofs = rawProofs is List
+        ? rawProofs.whereType<Map>().map((e) => Map<String, dynamic>.from(e)).toList()
+        : <Map<String, dynamic>>[];
+    return PassengerOperationStop(
+      id: (j['id'] as num?)?.toInt() ?? 0,
+      sequence: ((j['sequence'] ?? j['sequence_no']) as num?)?.toInt() ?? 0,
+      operationType: (j['operation_type'] ?? j['type'] ?? 'service').toString(),
+      status: (j['status'] ?? 'pending').toString().toLowerCase(),
+      address: (j['address'] ?? '').toString(),
+      name: (j['name'] ?? '').toString(),
+      contactName: (j['contact_name'] ?? '').toString(),
+      contactPhone: (j['contact_phone'] ?? '').toString(),
+      lat: d(j['lat']),
+      lng: d(j['lng']),
+      packageRef: (j['package_ref'] ?? '').toString(),
+      packageCount: (j['package_count'] as num?)?.toInt() ?? int.tryParse('${j['package_count'] ?? 0}') ?? 0,
+      packageWeightKg: d(j['package_weight_kg']) ?? 0,
+      packageSize: (j['package_size'] ?? '').toString(),
+      recipientName: (j['recipient_name'] ?? '').toString(),
+      recipientPhone: (j['recipient_phone'] ?? '').toString(),
+      notes: (j['notes'] ?? j['delivery_notes'] ?? '').toString(),
+      proofs: proofs,
+    );
+  }
+}
