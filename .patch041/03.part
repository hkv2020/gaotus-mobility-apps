@@ -99,6 +100,10 @@
     if(raw is! Map)throw const ApiException('Invalid chat response.');return ChatMessage.fromJson(Map<String,dynamic>.from(raw));
   }
 
+  Future<List<PlaceSuggestion>> placeAutocomplete(String input,{String sessionToken='',double? lat,double? lng}) async { final api=_api;if(api==null)throw const ApiException('Not connected.');final r=await api.placeAutocomplete(input,sessionToken:sessionToken,lat:lat,lng:lng);final raw=r['suggestions'];return raw is List?raw.whereType<Map>().map((e)=>PlaceSuggestion.fromJson(Map<String,dynamic>.from(e))).toList():<PlaceSuggestion>[];}
+  Future<PlaceSelection> placeDetails(String placeId,{String sessionToken=''}) async {final api=_api;if(api==null)throw const ApiException('Not connected.');final r=await api.placeDetails(placeId,sessionToken:sessionToken);final raw=r['place'];if(raw is! Map)throw const ApiException('Invalid place response.');return PlaceSelection.fromJson(Map<String,dynamic>.from(raw));}
+  Future<PlaceSelection> reverseGeocode(double lat,double lng) async {final api=_api;if(api==null)throw const ApiException('Not connected.');final r=await api.reverseGeocode(lat,lng);final raw=r['place'];if(raw is! Map)throw const ApiException('Unable to resolve address.');return PlaceSelection.fromJson(Map<String,dynamic>.from(raw));}
+
   Future<FareQuote> quote(Map<String,Object?> request) async {if(_api==null)throw const ApiException('Not connected.');busy=true;errorMessage=null;notifyListeners();try{lastQuoteRequest=Map<String,Object?>.from(request);lastQuote=FareQuote.fromJson(await _api!.quote(request));return lastQuote!;}finally{busy=false;notifyListeners();}}
   Future<PassengerBooking> createBooking(VehicleQuote vehicle,{String paymentMethod='online'}) async {if(_api==null||lastQuoteRequest==null)throw const ApiException('Request a fare first.');final body=<String,Object?>{...lastQuoteRequest!,'vehicle_id':vehicle.id,'payment_method':paymentMethod,'terms_accept':true};busy=true;notifyListeners();try{final r=await _api!.createBooking(body);final b=PassengerBooking.fromJson(Map<String,dynamic>.from(r['booking'] as Map));bookings.insert(0,b);activeBooking=b;await _connectBooking(b.id);return b;}finally{busy=false;notifyListeners();}}
   Future<Map<String,dynamic>> payment(int id)=>_api!.payment(id);
