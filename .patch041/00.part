diff -ruN passenger040_orig/lib/models/place_selection.dart passenger041_work/lib/models/place_selection.dart
--- passenger040_orig/lib/models/place_selection.dart	1970-01-01 00:00:00.000000000 +0000
+++ passenger041_work/lib/models/place_selection.dart	2026-09-23 09:45:30.109984404 +0000
@@ -0,0 +1,25 @@
+final class PlaceSuggestion {
+  const PlaceSuggestion({required this.placeId, required this.text, required this.mainText, required this.secondaryText});
+  final String placeId;
+  final String text;
+  final String mainText;
+  final String secondaryText;
+  factory PlaceSuggestion.fromJson(Map<String,dynamic> j)=>PlaceSuggestion(
+    placeId:(j['place_id']??'').toString(), text:(j['text']??'').toString(),
+    mainText:(j['main_text']??'').toString(), secondaryText:(j['secondary_text']??'').toString(),
+  );
+}
+
+final class PlaceSelection {
+  const PlaceSelection({required this.address, required this.lat, required this.lng, this.placeId='', this.name=''});
+  final String address;
+  final double lat;
+  final double lng;
+  final String placeId;
+  final String name;
+  factory PlaceSelection.fromJson(Map<String,dynamic> j)=>PlaceSelection(
+    address:(j['address']??'').toString(), name:(j['name']??'').toString(), placeId:(j['place_id']??'').toString(),
+    lat:(j['lat'] as num?)?.toDouble()??double.tryParse('${j['lat']}')??0,
+    lng:(j['lng'] as num?)?.toDouble()??double.tryParse('${j['lng']}')??0,
+  );
+}
