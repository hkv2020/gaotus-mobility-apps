           FilledButton(onPressed: () => Navigator.pop(context, selected), child: const Text('Confirm pick-up')),
-                  ],
-                ),
-              ),
-            ),
-          ],
-        ),
-      );
+  @override void initState(){
+    super.initState();
+    selected=widget.initial;
+    address=widget.initialAddress.trim();
+    if(address.isEmpty||address=='Current location'||address=='Selected pick-up') WidgetsBinding.instance.addPostFrameCallback((_)=>resolve());
+  }
+
+  @override void dispose(){debounce?.cancel();super.dispose();}
+
+  void moved(LatLng point){
+    selected=point;
+    debounce?.cancel();
+    debounce=Timer(const Duration(milliseconds:450),resolve);
+  }
+
+  Future<void> resolve() async{
+    if(!mounted)return;
+    setState(()=>resolving=true);
+    try{
+      final p=await widget.session.reverseGeocode(selected.latitude,selected.longitude);
+      if(mounted)setState(()=>address=p.address.isEmpty?'Selected map location':p.address);
+    }catch(_){if(mounted&&address.isEmpty)setState(()=>address='Selected map location');}
+    finally{if(mounted)setState(()=>resolving=false);}
+  }
+
+  @override Widget build(BuildContext context)=>Scaffold(
+    body:Stack(children:<Widget>[
+      Positioned.fill(child:FlutterMap(
+        options:MapOptions(initialCenter:widget.initial,initialZoom:17,onPositionChanged:(camera,hasGesture){if(hasGesture)moved(camera.center);}),
+        children:<Widget>[TileLayer(urlTemplate:'https://tile.openstreetmap.org/{z}/{x}/{y}.png',userAgentPackageName:'com.gaotus.mobility.passenger')],
+      )),
+      const IgnorePointer(child:Center(child:Padding(padding:EdgeInsets.only(bottom:32),child:Column(mainAxisSize:MainAxisSize.min,children:<Widget>[
+        DecoratedBox(decoration:BoxDecoration(color:AppTheme.ink,borderRadius:BorderRadius.all(Radius.circular(999))),child:Padding(padding:EdgeInsets.symmetric(horizontal:16,vertical:9),child:Text('Pick-up here',style:TextStyle(color:Colors.white,fontWeight:FontWeight.w800)))),
+        SizedBox(height:6),Icon(Icons.location_on_rounded,color:AppTheme.ink,size:48),
+      ])))),
+      Positioned(top:MediaQuery.paddingOf(context).top+10,left:16,child:FloatingCircleButton(icon:Icons.arrow_back,onPressed:()=>Navigator.pop(context))),
+      Align(alignment:Alignment.bottomCenter,child:Container(
+        padding:EdgeInsets.fromLTRB(20,8,20,MediaQuery.paddingOf(context).bottom+18),
+        decoration:const BoxDecoration(color:Colors.white,borderRadius:BorderRadius.vertical(top:Radius.circular(30))),
+        child:Column(mainAxisSize:MainAxisSize.min,crossAxisAlignment:CrossAxisAlignment.stretch,children:<Widget>[
+          const SheetHandle(),
+          Text('Confirm pick-up spot',textAlign:TextAlign.center,style:Theme.of(context).textTheme.headlineSmall),
+          const SizedBox(height:5),Text('Drag the map to move the pin',textAlign:TextAlign.center,style:Theme.of(context).textTheme.bodyLarge?.copyWith(color:AppTheme.softInk)),
+          const SizedBox(height:18),
+          Container(padding:const EdgeInsets.symmetric(horizontal:14,vertical:12),decoration:BoxDecoration(color:const Color(0xFFF3F3F1),borderRadius:BorderRadius.circular(18)),child:Row(children:<Widget>[
+            const Icon(Icons.trip_origin,size:18),const SizedBox(width:12),
+            Expanded(child:Text(address.isEmpty?'Finding address…':address,maxLines:2,overflow:TextOverflow.ellipsis,style:const TextStyle(fontWeight:FontWeight.w800,fontSize:15))),
+            if(resolving)const SizedBox(width:18,height:18,child:CircularProgressIndicator(strokeWidth:2)) else const Icon(Icons.gps_fixed),
+          ])),
+          const SizedBox(height:14),
+          FilledButton(onPressed:resolving?null:()=>Navigator.pop(context,PlaceSelection(address:address,lat:selected.latitude,lng:selected.longitude)),child:const Text('Confirm pick-up')),
+        ]),
+      )),
+    ]),
+  );
+}
diff -ruN passenger040_orig/lib/screens/place_search_screen.dart passenger041_work/lib/screens/place_search_screen.dart
--- passenger040_orig/lib/screens/place_search_screen.dart	1970-01-01 00:00:00.000000000 +0000
+++ passenger041_work/lib/screens/place_search_screen.dart	2026-09-23 09:45:30.110945583 +0000
@@ -0,0 +1,77 @@
+import 'dart:async';
+import 'dart:math';
+import 'package:flutter/material.dart';
+import '../models/place_selection.dart';
+import '../state/passenger_session.dart';
+import '../theme/app_theme.dart';
+
+class PlaceSearchScreen extends StatefulWidget {
+  const PlaceSearchScreen({super.key, required this.session, required this.title, this.biasLat, this.biasLng});
+  final PassengerSession session;
+  final String title;
+  final double? biasLat, biasLng;
+  @override State<PlaceSearchScreen> createState()=>_PlaceSearchScreenState();
+}
+
+class _PlaceSearchScreenState extends State<PlaceSearchScreen>{
+  final controller=TextEditingController();
+  final focus=FocusNode();
+  Timer? debounce;
+  List<PlaceSuggestion> suggestions=<PlaceSuggestion>[];
+  bool loading=false;
+  String? error;
+  late final String sessionToken;
+
+  @override void initState(){
+    super.initState();
+    sessionToken='gmp_${DateTime.now().microsecondsSinceEpoch}_${Random().nextInt(1<<31)}';
+    WidgetsBinding.instance.addPostFrameCallback((_)=>focus.requestFocus());
+  }
+
+  @override void dispose(){debounce?.cancel();controller.dispose();focus.dispose();super.dispose();}
+
+  void changed(String value){
+    debounce?.cancel();
+    if(value.trim().length<2){setState((){suggestions=<PlaceSuggestion>[];error=null;});return;}
+    debounce=Timer(const Duration(milliseconds:280),()=>search(value));
+  }
+
+  Future<void> search(String value) async{
+    setState((){loading=true;error=null;});
+    try{
+      final rows=await widget.session.placeAutocomplete(value,sessionToken:sessionToken,lat:widget.biasLat,lng:widget.biasLng);
+      if(mounted)setState(()=>suggestions=rows);
+    }catch(e){if(mounted)setState(()=>error='$e');}
+    finally{if(mounted)setState(()=>loading=false);}
+  }
+
+  Future<void> pick(PlaceSuggestion suggestion) async{
+    setState(()=>loading=true);
+    try{
+      final place=await widget.session.placeDetails(suggestion.placeId,sessionToken:sessionToken);
+      if(mounted)Navigator.pop(context,place);
+    }catch(e){if(mounted)setState(()=>error='$e');}
+    finally{if(mounted)setState(()=>loading=false);}
+  }
+
+  @override Widget build(BuildContext context)=>Scaffold(
+    appBar:AppBar(title:Text(widget.title)),
+    body:SafeArea(child:Column(children:<Widget>[
+      Padding(padding:const EdgeInsets.fromLTRB(16,12,16,8),child:TextField(
+        controller:controller,focusNode:focus,onChanged:changed,textInputAction:TextInputAction.search,
+        decoration:InputDecoration(prefixIcon:const Icon(Icons.search_rounded),hintText:'Search address, airport or place',suffixIcon:controller.text.isEmpty?null:IconButton(onPressed:(){controller.clear();changed('');setState((){});},icon:const Icon(Icons.close_rounded))),
+      )),
+      if(loading)const LinearProgressIndicator(minHeight:2),
+      if(error!=null)Padding(padding:const EdgeInsets.all(16),child:Text(error!,style:TextStyle(color:Theme.of(context).colorScheme.error))),
+      Expanded(child:suggestions.isEmpty&&!loading&&error==null?const Center(child:Padding(padding:EdgeInsets.all(28),child:Text('Start typing a street, postcode, airport or destination.',textAlign:TextAlign.center,style:TextStyle(color:AppTheme.softInk)))):ListView.separated(
+        padding:const EdgeInsets.symmetric(vertical:6),itemCount:suggestions.length,separatorBuilder:(_,__)=>const Divider(height:1,indent:64),
+        itemBuilder:(context,i){final s=suggestions[i];return ListTile(
+          leading:const CircleAvatar(backgroundColor:Color(0xFFF1F1EF),child:Icon(Icons.location_on_outlined,color:AppTheme.ink)),
+          title:Text(s.mainText.isNotEmpty?s.mainText:s.text,style:const TextStyle(fontWeight:FontWeight.w800)),
+          subtitle:s.secondaryText.isNotEmpty?Text(s.secondaryText,maxLines:2,overflow:TextOverflow.ellipsis):null,
+          onTap:()=>pick(s),
+        );},
+      )),
+    ])),
+  );
+}
